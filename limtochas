        // --- 전투 시스템 ---
        function toggleBattle() {
            if (inBattle) return;
            startBattle();
        }

        function startBattle() {
            inBattle = true;
            document.getElementById('battle-btn').innerText = '전투 진행 중...';
            document.getElementById('battle-btn').disabled = true;
            const enemyTag = document.getElementById('enemy-status-tag');
            if (enemyTag) enemyTag.classList.remove('hidden');

            initialBoardSnapshot = JSON.parse(JSON.stringify(board));

            // 아군 기물 전투 그리드 좌표 배치 (우리팀 3x8 구역, 행: 0~2, 열: 0~7)
            battleBoard = board.map((u, i) => {
                if (!u) return null;
                const r = Math.floor(i / 8);
                const c = i % 8;
                return {
                    ...u,
                    boardIdx: i,
                    r: r + 3, // 아군은 하단 3~5행에 배치
                    c: c,
                    isEnemy: false,
                    currentHp: u.hp,
                    maxHp: u.hp,
                    damageDealt: 0,
                    range: 1
                };
            });

            // 적군 기물 전투 그리드 좌표 배치 (상대팀 3x8 구역, 행: 0~2, 열: 0~7)
            enemyBoard = Array(24).fill(null);
            battleEnemyBoard = Array(24).fill(null);
            const enemyCount = Math.min(2 + playerState.stage + playerState.wave, 8);
            const availableSlots = Array.from({ length: 24 }, (_, i) => i);

            for (let i = 0; i < enemyCount; i++) {
                const randomUnit = BASE_UNITS[Math.floor(Math.random() * BASE_UNITS.length)];
                const slotIdx = availableSlots.splice(Math.floor(Math.random() * availableSlots.length), 1)[0];
                const r = Math.floor(slotIdx / 8);
                const c = slotIdx % 8;

                const enemyObj = {
                    ...randomUnit,
                    name: `환상체:${randomUnit.name}`,
                    star: Math.min(Math.floor(playerState.stage / 2) + 1, 3),
                    hp: Math.floor(randomUnit.hp * (1 + playerState.stage * 0.3)),
                    maxHp: Math.floor(randomUnit.hp * (1 + playerState.stage * 0.3)),
                    currentHp: Math.floor(randomUnit.hp * (1 + playerState.stage * 0.3)),
                    atk: Math.floor(randomUnit.atk * (1 + playerState.stage * 0.2)),
                    isEnemy: true,
                    boardIdx: slotIdx,
                    r: r, // 적군은 상단 0~2행에 배치
                    c: c,
                    damageDealt: 0,
                    range: 1
                };

                enemyBoard[slotIdx] = enemyObj;
                battleEnemyBoard[slotIdx] = enemyObj;
            }

            combatDamageRecord = {};
            renderBoardAndBench();
            // 전투 틱 600ms 주기로 구동
            battleInterval = setInterval(updateBattleTick, 600);
        }

        // 롤토체스 방식: 이동 및 거리 탐색 AI 엔진
        function updateBattleTick() {
            const allies = battleBoard.filter(u => u && u.currentHp > 0);
            const enemies = battleEnemyBoard.filter(u => u && u.currentHp > 0);

            if (allies.length === 0 || enemies.length === 0) {
                endBattle(enemies.length === 0);
                return;
            }

            // 모든 점유 칸 타일 map 생성 (총 6행 8열)
            const occupied = {};
            allies.forEach(a => { occupied[`${a.r},${a.c}`] = a; });
            enemies.forEach(e => { occupied[`${e.r},${e.c}`] = e; });

            const allUnits = [...allies, ...enemies];

            allUnits.forEach(unit => {
                if (unit.currentHp <= 0) return;

                const targets = unit.isEnemy ? allies : enemies;
                const activeTargets = targets.filter(t => t.currentHp > 0);
                if (activeTargets.length === 0) return;

                // 1. 가장 가까운 적 찾기 (맨해튼 거리)
                let closest = null;
                let minDist = 999;
                activeTargets.forEach(t => {
                    const dist = Math.abs(unit.r - t.r) + Math.abs(unit.c - t.c);
                    if (dist < minDist) {
                        minDist = dist;
                        closest = t;
                    }
                });

                if (!closest) return;

                // 2. 사거리(1칸) 내에 있으면 바로 공격
                if (minDist <= unit.range) {
                    const dmg = Math.max(5, unit.atk - closest.def);
                    closest.currentHp -= dmg;
                    unit.damageDealt += dmg;
                    if (!unit.isEnemy) {
                        combatDamageRecord[unit.name] = (combatDamageRecord[unit.name] || 0) + dmg;
                    }

                    if (closest.currentHp <= 0) {
                        closest.currentHp = 0;
                        if (closest.isEnemy) {
                            battleEnemyBoard[closest.boardIdx] = null;
                        } else {
                            battleBoard[closest.boardIdx] = null;
                        }
                        delete occupied[`${closest.r},${closest.c}`];
                    }
                } else {
                    // 3. 사거리 밖이면 적 방향으로 1칸 이동
                    let bestR = unit.r;
                    let bestC = unit.c;
                    let bestStepDist = minDist;

                    // 8방향 중 적에게 가장 가까워지는 빈 칸 탐색
                    const dirR = [ -1, 1, 0, 0, -1, -1, 1, 1 ];
                    const dirC = [ 0, 0, -1, 1, -1, 1, -1, 1 ];

                    for (let d = 0; d < 8; d++) {
                        const nr = unit.r + dirR[d];
                        const nc = unit.c + dirC[d];

                        // 체스판(0~5행, 0~7열) 내부인지 검사
                        if (nr >= 0 && nr < 6 && nc >= 0 && nc < 8) {
                            if (!occupied[`${nr},${nc}`]) {
                                const dToTarget = Math.abs(nr - closest.r) + Math.abs(nc - closest.c);
                                if (dToTarget < bestStepDist) {
                                    bestStepDist = dToTarget;
                                    bestR = nr;
                                    bestC = nc;
                                }
                            }
                        }
                    }

                    // 이동할 칸이 있다면 위치 업데이트
                    if (bestR !== unit.r || bestC !== unit.c) {
                        delete occupied[`${unit.r},${unit.c}`];
                        unit.r = bestR;
                        unit.c = bestC;
                        occupied[`${unit.r},${unit.c}`] = unit;
                    }
                }
            });

            renderBoardAndBench();
            renderDamageMeter();
        }

        // --- 전투 종료 처리 ---
        function endBattle(isWin) {
            clearInterval(battleInterval);
            inBattle = false;

            document.getElementById('battle-btn').innerText = '전투 시작';
            document.getElementById('battle-btn').disabled = false;
            const enemyTag = document.getElementById('enemy-status-tag');
            if (enemyTag) enemyTag.classList.add('hidden');

            // 체스판 원상복구 (원래 배치 상태로)
            board = JSON.parse(JSON.stringify(initialBoardSnapshot));
            enemyBoard = Array(24).fill(null);

            if (isWin) {
                const rewardGold = 5 + playerState.stage;
                playerState.gold += rewardGold;
                showToast(`승리! +${rewardGold} 골드 획득!`);

                // 무작위로 아이템 획득 기회 (6칸 이내)
                if (inventory.length < 6 && Math.random() < 0.4) {
                    const keys = Object.keys(ITEMS_DEF);
                    const randomItem = keys[Math.floor(Math.random() * keys.length)];
                    inventory.push(randomItem);
                    showToast(`전리품 획득: ${ITEMS_DEF[randomItem].name}!`);
                }

                playerState.wave++;
                if (playerState.wave > 3) {
                    playerState.stage++;
                    playerState.wave = 1;
                }
            } else {
                const damage = 5 + playerState.stage * 2;
                playerState.hp -= damage;
                showToast(`패배... ${damage} 피해를 입었습니다.`);

                if (playerState.hp <= 0) {
                    playerState.hp = 0;
                    alert('수감자 팀이 전멸하였습니다. 게임을 다시 시작합니다.');
                    location.reload();
                    return;
                }
            }

            rerollShop(true); // 라운드 종료 후 무료 리롤
            renderBoardAndBench();
            updateUI();
        }

        // --- 딜량 측정기 렌더링 ---
        function renderDamageMeter() {
            const listEl = document.getElementById('damage-meter-list');
            if (!listEl) return;

            const sorted = Object.entries(combatDamageRecord).sort((a, b) => b[1] - a[1]);
            if (sorted.length === 0) {
                listEl.innerHTML = `<div class="text-xs text-gray-500 italic text-center py-4">전투 중 딜량이 기록됩니다.</div>`;
                return;
            }

            const maxDmg = Math.max(...sorted.map(s => s[1]), 1);
            listEl.innerHTML = '';

            sorted.forEach(([name, dmg]) => {
                const pct = Math.min(100, Math.floor((dmg / maxDmg) * 100));
                listEl.innerHTML += `
                    <div class="space-y-1">
                        <div class="flex items-center justify-between text-[11px] font-bold">
                            <span class="text-gray-200">${name}</span>
                            <span class="text-red-400 font-mono">${dmg}</span>
                        </div>
                        <div class="w-full bg-gray-900 rounded-full h-1.5 overflow-hidden border border-gray-800">
                            <div class="bg-red-600 h-full transition-all duration-300" style="width: ${pct}%"></div>
                        </div>
                    </div>
                `;
            });
        }

        // --- 수감자 상세 모달 ---
        function showUnitDetail(source, idx) {
            const unit = (source === 'board') ? board[idx] : bench[idx];
            if (!unit) return;

            const modal = document.getElementById('unit-detail-modal');
            const content = document.getElementById('unit-detail-content');
            if (!modal || !content) return;

            const sinStyle = SIN_AFFINITIES[unit.sin] || { color: 'text-gray-300' };

            content.innerHTML = `
                <div class="text-center mb-4">
                    <span class="text-yellow-400 text-sm font-bold">${'★'.repeat(unit.star)}</span>
                    <h3 class="text-xl font-extrabold text-white mt-1">${unit.name}</h3>
                    <div class="flex items-center justify-center gap-2 text-xs font-bold mt-1">
                        <span class="${sinStyle.color}">${sinStyle.icon} ${unit.sin}</span>
                        <span class="text-gray-500">•</span>
                        <span class="text-gray-300">소속: ${unit.faction}</span>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2 bg-black/50 p-3 rounded-lg border border-gray-800 text-center text-xs mb-4">
                    <div>
                        <div class="text-gray-500">체력</div>
                        <div class="font-bold text-green-400">${unit.hp}</div>
                    </div>
                    <div>
                        <div class="text-gray-500">공격력</div>
                        <div class="font-bold text-red-400">${unit.atk}</div>
                    </div>
                    <div>
                        <div class="text-gray-500">방어력</div>
                        <div class="font-bold text-blue-400">${unit.def}</div>
                    </div>
                </div>

                <div class="bg-red-950/30 border border-red-900/50 p-3 rounded-lg text-xs">
                    <div class="font-bold text-red-400 mb-1"><i class="fa-solid fa-burst"></i> 대표 E.G.O: ${unit.ego}</div>
                    <div class="text-gray-400">전투 중 게이지 충전 시 주변 대상에게 죄악 피해를 입힙니다.</div>
                </div>
            `;

            modal.classList.remove('hidden');
        }

        function closeUnitDetailModal() {
            const modal = document.getElementById('unit-detail-modal');
            if (modal) modal.classList.add('hidden');
        }

        // --- 모달 관리 (시너지, 아이템) ---
        function openSynergyModal() {
            const modal = document.getElementById('synergy-modal');
            const content = document.getElementById('synergy-modal-content');
            if (!modal || !content) return;

            content.innerHTML = '<h3 class="font-bold text-sm text-gray-300 mb-2">죄악 속성 시너지</h3>';
            for (let s in SIN_AFFINITIES) {
                const style = SIN_AFFINITIES[s];
                content.innerHTML += `
                    <div class="bg-gray-900 border border-gray-800 p-2.5 rounded-lg flex items-center justify-between text-xs">
                        <span class="font-bold ${style.color}">${style.icon} ${s} 속성</span>
                        <span class="text-gray-400">속성 기물 수에 따라 스킬 피해 증가</span>
                    </div>
                `;
            }

            content.innerHTML += '<h3 class="font-bold text-sm text-gray-300 mt-4 mb-2">소속 시너지</h3>';
            for (let f in FACTIONS) {
                content.innerHTML += `
                    <div class="bg-gray-900 border border-gray-800 p-2.5 rounded-lg text-xs space-y-0.5">
                        <div class="font-bold text-red-400">${f}</div>
                        <div class="text-gray-400">${FACTIONS[f]}</div>
                    </div>
                `;
            }

            modal.classList.remove('hidden');
        }

        function closeSynergyModal() {
            const modal = document.getElementById('synergy-modal');
            if (modal) modal.classList.add('hidden');
        }

        function openItemModal() {
            const modal = document.getElementById('item-modal');
            const content = document.getElementById('item-modal-content');
            if (!modal || !content) return;

            content.innerHTML = '';
            for (let id in ITEMS_DEF) {
                const item = ITEMS_DEF[id];
                content.innerHTML += `
                    <div class="bg-gray-900 border border-yellow-800/60 p-3 rounded-lg flex items-start gap-3 text-xs">
                        <span class="text-2xl">${item.icon}</span>
                        <div>
                            <div class="font-bold text-yellow-400 mb-0.5">${item.name}</div>
                            <div class="text-gray-300">${item.desc}</div>
                        </div>
                    </div>
                `;
            }

            modal.classList.remove('hidden');
        }

        function closeItemModal() {
            const modal = document.getElementById('item-modal');
            if (modal) modal.classList.add('hidden');
        }

        // --- 단축키 이벤트 수신기 ---
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const modal = document.getElementById('synergy-modal');
                if (modal.classList.contains('hidden')) openSynergyModal();
                else closeSynergyModal();
            } else if (e.key === 'i' || e.key === 'I') {
                const modal = document.getElementById('item-modal');
                if (modal.classList.contains('hidden')) openItemModal();
                else closeItemModal();
            } else if (e.key === 'Escape') {
                closeUnitDetailModal();
                closeSynergyModal();
                closeItemModal();
            }
        });

        // --- 초기화 ---
        window.onload = function() {
            rerollShop(true);
            renderBoardAndBench();
            updateUI();
        };
    </script>
</body>
</html>
