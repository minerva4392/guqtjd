        // --- Drag and Drop Logic ---
        function allowDrop(e) {
            e.preventDefault();
        }

        function dragStart(e, source, idx) {
            if (inBattle) return;
            draggedData = { type: 'unit', source, idx };
        }

        function dragItemStart(e, itemIdx) {
            if (inBattle) return;
            draggedData = { type: 'item', itemIdx };
        }

        function dropToCell(e, targetType, targetIdx) {
            e.preventDefault();
            if (!draggedData || inBattle) return;

            if (draggedData.type === 'item') {
                // 아이템을 수감자에게 드래그 적용
                const targetUnit = (targetType === 'board') ? board[targetIdx] : bench[targetIdx];
                if (!targetUnit) {
                    showToast('아이템을 배치된 수감자 위로 드래그하세요.');
                    return;
                }
                applyItemToUnit(draggedData.itemIdx, targetType, targetIdx);
                draggedData = null;
                return;
            }

            if (draggedData.type === 'unit') {
                const { source, idx: srcIdx } = draggedData;
                const srcArr = (source === 'board') ? board : bench;
                const tgtArr = (targetType === 'board') ? board : bench;

                const movingUnit = srcArr[srcIdx];
                if (!movingUnit) return;

                // 기물 수 제한 체크 (벤치 -> 체스판 이동시)
                if (source === 'bench' && targetType === 'board' && tgtArr[targetIdx] === null) {
                    if (getDeployedUnitCount() >= getUnitLimit()) {
                        showToast(`현재 최대 ${getUnitLimit()}명까지 배치할 수 있습니다.`);
                        return;
                    }
                }

                // 스왑 및 이동
                const temp = tgtArr[targetIdx];
                tgtArr[targetIdx] = movingUnit;
                srcArr[srcIdx] = temp;

                checkAutoMerge();
                renderBoardAndBench();
                updateUI();
                draggedData = null;
            }
        }

        function dropToSell(e) {
            e.preventDefault();
            if (!draggedData || inBattle || draggedData.type !== 'unit') return;

            const { source, idx } = draggedData;
            const arr = (source === 'board') ? board : bench;
            const unit = arr[idx];

            if (unit) {
                const refundCost = unit.cost * unit.star;
                playerState.gold += refundCost;
                arr[idx] = null;
                showToast(`${unit.name} 판매 완료 (+${refundCost}G)`);
                renderBoardAndBench();
                updateUI();
            }
            draggedData = null;
        }

        // --- 아이템 적용 로직 ---
        function applyItemToUnit(itemIdx, targetType, targetIdx) {
            const itemKey = inventory[itemIdx];
            if (!itemKey) return;
            const item = ITEMS_DEF[itemKey];
            const arr = (targetType === 'board') ? board : bench;
            const unit = arr[targetIdx];

            if (!unit) return;

            if (itemKey === 'sword_blade_lineage') {
                if (unit.star < 3) {
                    showToast('검계의 검은 3성 수감자에게만 사용할 수 있습니다.');
                    return;
                }
                if (!item.targets.includes(unit.name)) {
                    showToast('해당 수감자는 검계 전림 아이템 사용 대상이 아닙니다.');
                    return;
                }
                unit.star = 4;
                if (!unit.faction.includes('검계')) {
                    unit.faction = unit.faction + '/검계';
                }
                unit.atk += 25;
                unit.hp += 100;
                unit.maxHp += 100;
                unit.currentHp += 100;

                inventory.splice(itemIdx, 1);
                showToast(`[검계의 검] 전림! ${unit.name} 4성 강화 및 [검계] 소속 부여!`);
            } else if (itemKey === 'ego_shard') {
                if (unit.star >= 3) {
                    showToast('E.G.O 파편은 1~2성 수감자에게만 적용할 수 있습니다.');
                    return;
                }
                unit.star += 1;
                unit.atk = Math.floor(unit.atk * 2.2);
                unit.hp = Math.floor(unit.hp * 2.5);
                unit.maxHp = unit.hp;
                unit.currentHp = unit.hp;

                inventory.splice(itemIdx, 1);
                showToast(`E.G.O 파편 흡수! ${unit.name} ${unit.star}성 진화!`);
            }

            checkAutoMerge();
            renderBoardAndBench();
            updateUI();
        }

        // --- 시너지 계산 ---
        function updateSynergies() {
            const listEl = document.getElementById('active-synergies-list');
            if (!listEl) return;

            const activeBoardUnits = board.filter(u => u !== null);
            const sinCounts = {};
            const factionCounts = {};

            activeBoardUnits.forEach(u => {
                sinCounts[u.sin] = (sinCounts[u.sin] || 0) + 1;
                const factions = u.faction.split('/');
                factions.forEach(f => {
                    factionCounts[f] = (factionCounts[f] || 0) + 1;
                });
            });

            listEl.innerHTML = '';

            // 소속 시너지
            for (let f in factionCounts) {
                listEl.innerHTML += `
                    <div class="bg-gray-900 border border-red-900/60 p-1.5 rounded flex items-center justify-between">
                        <span class="font-bold text-red-400">${f}</span>
                        <span class="text-xs text-yellow-400 font-extrabold">${factionCounts[f]}명</span>
                    </div>
                `;
            }

            // 속성 시너지
            for (let s in sinCounts) {
                const style = SIN_AFFINITIES[s] || { color: 'text-gray-300' };
                listEl.innerHTML += `
                    <div class="bg-gray-900 border border-gray-800 p-1.5 rounded flex items-center justify-between">
                        <span class="font-bold ${style.color}">${style.icon} ${s}</span>
                        <span class="text-xs text-yellow-400 font-extrabold">${sinCounts[s]}명</span>
                    </div>
                `;
            }

            if (Object.keys(sinCounts).length === 0 && Object.keys(factionCounts).length === 0) {
                listEl.innerHTML = `<div class="text-gray-600 text-xs italic text-center py-2">배치된 기물이 없습니다.</div>`;
