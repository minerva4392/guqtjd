<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>림버스 컴퍼니 오토체스</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 아이콘 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap');
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: #0b0c10;
            color: #c5c6c7;
            user-select: none;
        }
        .bg-limbus-card {
            background-color: #12141c;
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col justify-between bg-black text-gray-200">

    <!-- 상단 헤더 UI -->
    <header class="bg-limbus-card border-b border-red-900/50 px-4 py-2 flex items-center justify-between z-10 shadow-lg shrink-0">
        <!-- 좌측: 제목 및 STAGE 표시 -->
        <div class="flex items-center gap-3">
            <h1 class="text-lg font-extrabold tracking-wider text-red-600 flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-clock text-red-500"></i> LIMBUS AUTOCHESS
            </h1>
            <div class="bg-red-950/80 border border-red-800 text-red-400 font-bold px-2.5 py-1 rounded text-xs whitespace-nowrap">
                STAGE <span id="stage-text">1-1</span>
            </div>
            <!-- 단축키 안내 -->
            <div class="hidden md:flex items-center gap-1.5 ml-2 text-[11px] text-gray-400 border-l border-gray-800 pl-3">
                <button onclick="openSynergyModal()" class="bg-gray-900 hover:bg-gray-800 border border-gray-700 text-gray-300 px-2 py-0.5 rounded transition flex items-center gap-1">
                    <span class="bg-gray-800 text-yellow-400 px-1 rounded font-mono text-[10px]">Tab</span> 시너지
                </button>
                <button onclick="openItemModal()" class="bg-gray-900 hover:bg-gray-800 border border-gray-700 text-gray-300 px-2 py-0.5 rounded transition flex items-center gap-1">
                    <span class="bg-gray-800 text-yellow-400 px-1 rounded font-mono text-[10px]">I</span> 아이템 도감
                </button>
            </div>
        </div>

        <!-- 우측: 재화 및 상태 정보 -->
        <div class="flex items-center gap-3 text-xs font-bold whitespace-nowrap">
            <div class="flex items-center gap-1.5 text-yellow-400 bg-yellow-950/30 px-2.5 py-1 rounded border border-yellow-800/40">
                <i class="fa-solid fa-coins"></i>
                <span id="gold-text">10</span> G
            </div>
            <div class="flex items-center gap-1.5 text-blue-400 bg-blue-950/30 px-2.5 py-1 rounded border border-blue-800/40">
                <i class="fa-solid fa-graduation-cap"></i>
                LV <span id="level-text">1</span>
                <span class="text-[10px] text-gray-400 font-normal">
                    (<span id="xp-text">0/4</span> XP)
                </span>
            </div>
            <div class="flex items-center gap-1.5 text-green-400 bg-green-950/30 px-2.5 py-1 rounded border border-green-800/40">
                <i class="fa-solid fa-heart"></i>
                <span id="player-hp">100</span> HP
            </div>
            <button id="battle-btn" onclick="toggleBattle()" class="bg-red-700 hover:bg-red-600 active:bg-red-800 text-white font-extrabold px-4 py-1.5 rounded-lg border border-red-500 shadow transition">
                전투 시작
            </button>
        </div>
    </header>

    <!-- 중앙 게임 구역 (좌: 시너지 & 아이템 / 중: 체스판 & 벤치 / 우: 딜량 측정기) -->
    <main class="flex-1 flex overflow-hidden p-3 gap-3">
        <!-- 좌측: 활성 시너지 요약 및 아이템 보관함 -->
        <aside class="w-48 bg-limbus-card border border-gray-800 rounded-lg p-2.5 flex flex-col gap-3 shrink-0">
            <div class="flex-1 flex flex-col min-h-0">
                <h2 class="text-xs font-bold text-gray-400 mb-2 border-b border-gray-800 pb-1 flex items-center gap-1">
                    <i class="fa-solid fa-bars-staggered"></i> 활성 시너지 (Tab)
                </h2>
                <div id="active-synergies-list" class="flex-1 overflow-y-auto space-y-1.5 pr-1 text-xs">
                    <!-- JS dynamic -->
                </div>
            </div>

            <!-- 아이템 보관함 (6칸) -->
            <div class="border-t border-gray-800 pt-2 flex flex-col gap-1.5">
                <span class="text-xs font-bold text-yellow-500 flex items-center justify-between">
                    <span><i class="fa-solid fa-shield-halved"></i> 아이템 (6칸)</span>
                    <span class="text-[10px] text-gray-500">드래그 적용</span>
                </span>
                <div id="inventory-slots" class="grid grid-cols-3 gap-1.5">
                    <!-- JS dynamic -->
                </div>
            </div>
        </aside>

        <!-- 중앙: 체스판 & 벤치 -->
        <section class="flex-1 flex flex-col gap-3 min-w-0">
            <!-- 체스판 (상대 3행 8열 + 우리팀 3행 8열) -->
            <div class="flex-1 bg-gradient-to-b from-gray-950 to-black border border-gray-800 rounded-lg p-3 flex flex-col justify-between shadow-inner relative">
                <div class="absolute top-2 left-3 text-[11px] text-gray-500 font-bold flex items-center gap-2 z-10">
                    <span>배치 가능 기물: <strong id="unit-limit-text" class="text-yellow-400">0/1</strong></span>
                    <span id="enemy-status-tag" class="text-red-400 font-extrabold hidden ml-4"><i class="fa-solid fa-skull"></i> 적 등장 중!</span>
                </div>
                
                <div class="flex-1 flex flex-col gap-2 mt-5">
                    <!-- 상대팀 구역 -->
                    <div class="text-[10px] font-bold text-red-500/70 border-b border-red-900/30 pb-0.5">상대팀 영역</div>
                    <div id="enemy-board" class="grid grid-cols-8 grid-rows-3 gap-1.5 flex-1 bg-red-950/10 border border-red-950/40 rounded p-1">
                        <!-- JS 적 전용 렌더링 -->
                    </div>

                    <!-- 우리팀 구역 -->
                    <div class="text-[10px] font-bold text-blue-500/70 border-b border-blue-900/30 pb-0.5 mt-1">우리팀 영역</div>
                    <div id="chess-board" class="grid grid-cols-8 grid-rows-3 gap-1.5 flex-1 bg-blue-950/10 border border-blue-950/40 rounded p-1">
                        <!-- JS 아군 24칸 grid 렌더링 -->
                    </div>
                </div>
            </div>

            <!-- 대기석(벤치 8칸) -->
            <div class="bg-limbus-card border border-gray-800 rounded-lg p-2.5 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2 w-full">
                    <span class="text-xs font-bold text-gray-400 w-12 text-center shrink-0">대기석</span>
                    <div id="bench-slots" class="grid grid-cols-8 gap-2 flex-1">
                        <!-- JS로 8개 벤치 칸 렌더링 -->
                    </div>
                </div>
            </div>
        </section>

        <!-- 우측: 실시간 전투 딜량 랭킹 -->
        <aside class="w-60 bg-limbus-card border border-gray-800 rounded-lg p-3 flex flex-col shrink-0">
            <h2 class="text-xs font-bold text-gray-300 border-b border-gray-800 pb-2 flex items-center gap-1.5">
                <i class="fa-solid fa-chart-simple text-red-500"></i> 실시간 딜량 순위
            </h2>
            <div id="damage-meter-list" class="flex-1 overflow-y-auto mt-2 space-y-2 pr-1 text-xs">
                <div class="text-xs text-gray-500 italic text-center py-4">전투 중 딜량이 기록됩니다.</div>
            </div>
        </aside>
    </main>

    <!-- 하단 상점 패널 -->
    <footer class="bg-limbus-card border-t border-red-900/30 p-3 flex items-center justify-between gap-4 z-10 shadow-2xl shrink-0">
        <!-- 레벨 업 & 리롤 버튼 -->
        <div class="flex flex-col gap-1.5 w-32 shrink-0">
            <button onclick="buyXP()" class="bg-gray-800 hover:bg-gray-700 active:bg-gray-900 text-gray-200 border border-gray-700 py-1.5 px-2 rounded-lg flex items-center justify-between transition w-full shadow">
                <span class="text-xs font-bold flex items-center gap-1"><i class="fa-solid fa-arrow-up text-green-400"></i> 레벨업 <span class="text-[10px] text-green-400 font-extrabold">+4</span></span>
                <span id="xp-cost-text" class="text-[10px] text-yellow-400 font-bold">4 골드</span>
            </button>
            <button onclick="rerollShop()" class="bg-gray-800 hover:bg-gray-700 active:bg-gray-900 text-gray-200 border border-gray-700 py-1.5 px-2 rounded-lg flex items-center justify-between transition w-full shadow">
                <span class="text-xs font-bold flex items-center gap-1"><i class="fa-solid fa-rotate text-blue-400"></i> 리롤</span>
                <span class="text-[10px] text-yellow-400 font-bold">2 골드</span>
            </button>
        </div>

        <!-- 수감자 뽑기 슬롯 (5개) -->
        <div id="shop-cards-container" class="flex-1 grid grid-cols-5 gap-2">
            <!-- JS dynamic cards -->
        </div>

        <!-- 판매 구역 -->
        <div id="sell-zone" ondragover="allowDrop(event)" ondrop="dropToSell(event)" 
             class="w-32 border-2 border-dashed border-red-800/60 bg-red-950/20 rounded-lg flex flex-col items-center justify-center p-2 text-red-500 hover:bg-red-900/30 transition shrink-0">
            <i class="fa-solid fa-trash-can text-lg mb-1"></i>
            <span class="text-xs font-bold">드래그하여 판매</span>
        </div>
    </footer>

    <!-- 수감자 상세 정보 모달 -->
    <div id="unit-detail-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
        <div class="bg-limbus-card border border-red-800 rounded-xl w-full max-w-md p-5 shadow-2xl relative">
            <button onclick="closeUnitDetailModal()" class="absolute top-3 right-3 text-gray-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div id="unit-detail-content">
                <!-- JS dynamic content -->
            </div>
        </div>
    </div>

    <!-- 시너지 정보 상세 모달 -->
    <div id="synergy-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
        <div class="bg-limbus-card border border-gray-800 rounded-xl w-full max-w-lg p-5 shadow-2xl relative">
            <button onclick="closeSynergyModal()" class="absolute top-3 right-3 text-gray-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h2 class="text-lg font-bold text-red-500 mb-3 flex items-center gap-2">
                <i class="fa-solid fa-layer-group"></i> 전체 소속 및 속성 시너지 현황
            </h2>
            <div id="synergy-modal-content" class="space-y-3 max-h-96 overflow-y-auto pr-2">
                <!-- JS dynamic -->
            </div>
        </div>
    </div>

    <!-- 아이템 도감 모달 -->
    <div id="item-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
        <div class="bg-limbus-card border border-yellow-800/80 rounded-xl w-full max-w-lg p-5 shadow-2xl relative">
            <button onclick="closeItemModal()" class="absolute top-3 right-3 text-gray-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h2 class="text-lg font-bold text-yellow-400 mb-3 flex items-center gap-2">
                <i class="fa-solid fa-book-open"></i> 전리품 / 진화 아이템 도감
            </h2>
            <div id="item-modal-content" class="space-y-3 max-h-96 overflow-y-auto pr-2">
                <!-- JS dynamic -->
            </div>
        </div>
    </div>

    <!-- 알림 메시지 토스트 -->
    <div id="toast-msg" class="hidden fixed bottom-20 left-1/2 -translate-x-1/2 bg-red-900 border border-red-500 text-white text-xs px-4 py-2 rounded-lg shadow-2xl z-50 pointer-events-none transition-all duration-300">
    </div>

    <script>
        // --- 데이터 및 상수 정의 ---
        const SIN_AFFINITIES = {
            '분노': { color: 'text-red-500', bg: 'bg-red-950', border: 'border-red-700', icon: '🔥' },
            '색욕': { color: 'text-orange-500', bg: 'bg-orange-950', border: 'border-orange-700', icon: '🧡' },
            '나태': { color: 'text-yellow-500', bg: 'bg-yellow-950', border: 'border-yellow-700', icon: '⚡' },
            '탐식': { color: 'text-green-500', bg: 'bg-green-950', border: 'border-green-700', icon: '🍏' },
            '우울': { color: 'text-cyan-500', bg: 'bg-cyan-950', border: 'border-cyan-700', icon: '💧' },
            '오만': { color: 'text-blue-500', bg: 'bg-blue-950', border: 'border-blue-700', icon: '🗡️' },
            '질투': { color: 'text-purple-500', bg: 'bg-purple-950', border: 'border-purple-700', icon: '💜' }
        };

        const FACTIONS = {
            'LCB': 'LCB 수감자 기본 패시브: 공격력 +10%',
            '검계': '검계 수감자: 크리티컬 피해 +30% 및 공격력 +20%'
        };

        const BASE_UNITS = [
            { name: '이상', sin: '나태', faction: 'LCB', cost: 1, hp: 120, atk: 18, def: 5, ego: '오감도' },
            { name: '파우스트', sin: '오만', faction: 'LCB', cost: 1, hp: 110, atk: 20, def: 4, ego: '표상방출기' },
            { name: '돈키호테', sin: '색욕', faction: 'LCB', cost: 2, hp: 130, atk: 22, def: 6, ego: '피의 욕망' },
            { name: '료슈', sin: '색욕', faction: 'LCB', cost: 2, hp: 105, atk: 26, def: 3, ego: '삼도천' },
            { name: '뫼르소', sin: '오만', faction: 'LCB', cost: 2, hp: 160, atk: 15, def: 10, ego: '타인의 사슬' },
            { name: '홍루', sin: '탐식', faction: 'LCB', cost: 3, hp: 125, atk: 24, def: 5, ego: '허허실실' },
            { name: '히스클리프', sin: '질투', faction: 'LCB', cost: 3, hp: 140, atk: 25, def: 7, ego: '시체자루' },
            { name: '이스마엘', sin: '우울', faction: 'LCB', cost: 3, hp: 135, atk: 23, def: 6, ego: '홍염살' },
            { name: '로쟈', sin: '오만', faction: 'LCB', cost: 4, hp: 150, atk: 27, def: 8, ego: '던져진 도끼' },
            { name: '싱클레어', sin: '탐식', faction: 'LCB', cost: 4, hp: 115, atk: 30, def: 4, ego: '나무꾼' },
            { name: '오티스', sin: '우울', faction: 'LCB', cost: 4, hp: 130, atk: 28, def: 7, ego: '토포스' },
            { name: '그레고르', sin: '나태', faction: 'LCB', cost: 4, hp: 170, atk: 32, def: 9, ego: '어느날의 지네' }
        ];

        const ITEMS_DEF = {
            'sword_blade_lineage': {
                id: 'sword_blade_lineage',
                name: '검계의 검',
                icon: '🗡️',
                desc: '3성 이상, 파우스트, 돈키호테, 뫼르소, 오티스, 싱클레어 전용. 4성 승급 & [검계] 소속 추가 부여',
                targets: ['이상', '파우스트', '돈키호테', '뫼르소', '오티스', '싱클레어']
            },
            'ego_shard': {
                id: 'ego_shard',
                name: 'E.G.O 파편',
                icon: '💎',
                desc: '1~2성 수감자에게 사용 시 즉시 +1성급 진화',
                targets: 'all'
            }
        };

        // --- 상태 관리 변수 ---
        let playerState = {
            gold: 10,
            level: 1,
            xp: 0,
            hp: 100,
            stage: 1,
            wave: 1
        };
        let board = Array(24).fill(null); // 우리팀 3x8 체스판 (24칸)
        let enemyBoard = Array(24).fill(null); // 상대팀 3x8 체스판 (24칸)
        let bench = Array(8).fill(null);  // 8칸 대기석
        let shopCards = Array(5).fill(null); // 5개 상점 슬롯
        let inventory = ['sword_blade_lineage', 'ego_shard']; // 아이템 슬롯 6칸 최대

        let inBattle = false;
        let battleInterval = null;
        let battleBoard = Array(24).fill(null); // 아군 전투 상태
        let battleEnemyBoard = Array(24).fill(null); // 적군 전투 상태
        let combatDamageRecord = {};
        let initialBoardSnapshot = [];
        let draggedData = null;

        // --- 계산식 및 유틸리티 ---
        function getRequiredXP(level) {
            return level * 4;
        }

        function getUnitLimit() {
            return playerState.level;
        }

        function getDeployedUnitCount() {
            return board.filter(cell => cell !== null).length;
        }

        function showToast(msg) {
            const el = document.getElementById('toast-msg');
            if (!el) return;
            el.innerText = msg;
            el.classList.remove('hidden');
            setTimeout(() => {
                el.classList.add('hidden');
            }, 2000);
        }

        // --- UI 안전 업데이트 ---
        function updateUI() {
            const setTxt = (id, txt) => {
                const el = document.getElementById(id);
                if (el) el.innerText = txt;
            };

            setTxt('gold-text', playerState.gold);
            setTxt('level-text', playerState.level);
            setTxt('xp-text', `${playerState.xp}/${getRequiredXP(playerState.level)}`);
            setTxt('player-hp', playerState.hp);
            setTxt('stage-text', `${playerState.stage}-${playerState.wave}`);
            setTxt('unit-limit-text', `${getDeployedUnitCount()}/${getUnitLimit()}`);

            updateSynergies();
            renderInventory();
        }

        // --- 상점 렌더링 & 구매 & 리롤 ---
        function rerollShop(isFree = false) {
            if (inBattle) {
                showToast('전투 중에는 리롤을 할 수 없습니다.');
                return;
            }
            if (!isFree) {
                if (playerState.gold < 2) {
                    showToast('골드가 부족합니다!');
                    return;
                }
                playerState.gold -= 2;
            }

            shopCards = [];
            for (let i = 0; i < 5; i++) {
                const randomIndex = Math.floor(Math.random() * BASE_UNITS.length);
                const unitTemplate = BASE_UNITS[randomIndex];
                shopCards.push({
                    ...unitTemplate,
                    star: 1,
                    currentHp: unitTemplate.hp,
                    maxHp: unitTemplate.hp,
                    damageDealt: 0,
                    uid: Date.now() + Math.random()
                });
            }
            renderShop();
            updateUI();
        }

        function renderShop() {
            const container = document.getElementById('shop-cards-container');
            if (!container) return;
            container.innerHTML = '';

            shopCards.forEach((card, idx) => {
                if (!card) {
                    container.innerHTML += `<div class="bg-gray-900/40 border border-gray-800/50 rounded-lg p-2 flex items-center justify-center text-xs text-gray-600">구매 완료</div>`;
                    return;
                }

                const sinStyle = SIN_AFFINITIES[card.sin] || { color: 'text-gray-300', bg: 'bg-gray-900', border: 'border-gray-700', icon: '❓' };
                
                const cardHtml = `
                    <div onclick="buyUnit(${idx})" class="bg-limbus-card border ${sinStyle.border} rounded-lg p-2.5 flex flex-col justify-between hover:border-yellow-400 hover:scale-[1.02] active:scale-[0.98] cursor-pointer transition relative shadow select-none group">
                        <div class="flex items-center justify-between">
                            <span class="font-extrabold text-xs text-white group-hover:text-yellow-300 transition">${card.name}</span>
                            <span class="text-[10px] text-yellow-400 font-bold bg-yellow-950/80 border border-yellow-800/60 px-1.5 py-0.5 rounded">${card.cost}G</span>
                        </div>
                        <div class="text-[10px] space-y-0.5 my-1.5">
                            <div class="${sinStyle.color} font-bold flex items-center gap-1">
                                <span>${sinStyle.icon}</span> ${card.sin}
                            </div>
                            <div class="text-gray-400 font-medium">소속: ${card.faction}</div>
                        </div>
                    </div>
                `;
                container.innerHTML += cardHtml;
            });
        }

        function buyUnit(shopIdx) {
            if (inBattle) {
                showToast('전투 중에는 구매가 불가능합니다.');
                return;
            }
            const card = shopCards[shopIdx];
            if (!card) return;

            if (playerState.gold < card.cost) {
                showToast('골드가 부족합니다!');
                return;
            }

            // 빈 대기석 칸 찾기
            const emptyBenchIdx = bench.findIndex(item => item === null);
            if (emptyBenchIdx === -1) {
                showToast('대기석이 가득 찼습니다!');
                return;
            }

            playerState.gold -= card.cost;
            bench[emptyBenchIdx] = { ...card };
            shopCards[shopIdx] = null;

            checkAutoMerge();
            renderShop();
            renderBoardAndBench();
            updateUI();
        }

        function buyXP() {
            if (inBattle) {
                showToast('전투 중에는 XP를 올릴 수 없습니다.');
                return;
            }
            if (playerState.gold < 4) {
                showToast('골드가 부족합니다!');
                return;
            }

            playerState.gold -= 4;
            playerState.xp += 4;

            while (playerState.xp >= getRequiredXP(playerState.level)) {
                playerState.xp -= getRequiredXP(playerState.level);
                playerState.level++;
                showToast(`레벨 업! 현재 레벨: ${playerState.level}`);
            }

            updateUI();
        }

        // --- 자동 합성 (3개 동일 유닛 -> 성급 상승) ---
        function checkAutoMerge() {
            let merged = false;
            for (let star = 1; star <= 3; star++) {
                const countMap = {};
                // 체스판과 벤치 전체 검색
                const allUnits = [];
                board.forEach((u, i) => { if (u && u.star === star) allUnits.push({ unit: u, location: 'board', idx: i }); });
                bench.forEach((u, i) => { if (u && u.star === star) allUnits.push({ unit: u, location: 'bench', idx: i }); });

                allUnits.forEach(item => {
                    if (!countMap[item.unit.name]) countMap[item.unit.name] = [];
                    countMap[item.unit.name].push(item);
                });

                for (let name in countMap) {
                    if (countMap[name].length >= 3) {
                        const targetTrio = countMap[name].slice(0, 3);
                        // 첫 번째 위치에 1단계 강화된 유닛 배치
                        const primary = targetTrio[0];
                        const upgraded = {
                            ...primary.unit,
                            star: primary.unit.star + 1,
                            hp: Math.floor(primary.unit.hp * 2.5),
                            maxHp: Math.floor(primary.unit.maxHp * 2.5),
                            currentHp: Math.floor(primary.unit.maxHp * 2.5),
                            atk: Math.floor(primary.unit.atk * 2.2)
                        };

                        // 3개 유닛 삭제
                        targetTrio.forEach(t => {
                            if (t.location === 'board') board[t.idx] = null;
                            else bench[t.idx] = null;
                        });

                        // 최종 기물 승급 배치
                        if (primary.location === 'board') board[primary.idx] = upgraded;
                        else bench[primary.idx] = upgraded;

                        showToast(`★ ${upgraded.name} ${upgraded.star}성 승급 완료!`);
                        merged = true;
                        break;
                    }
                }
                if (merged) break;
            }

            if (merged) {
                checkAutoMerge();
            }
        }

